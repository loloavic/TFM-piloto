OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vacío = endpoints internos deshabilitados (503). Inyectar un secreto fuerte.
INTERNAL_API_TOKEN=
SESSION_TTL_SECONDS=1800
SESSION_CLEANUP_INTERVAL_SECONDS=30
SESSION_MAX_COUNT=256
# Límites de red por petición, sin reintentos automáticos.
PROVIDER_TIMEOUT_SECONDS=30
SESSION_WAIT_SECONDS=5
# False para HTTP local; True solo detrás de HTTPS.
GRADIO_COOKIE_SECURE=false
